# Copy to .env and fill in. The app auto-detects which provider you've
# configured by looking at which key is set
# (priority: anthropic > groq > openai > stub).

# --- LLM provider (pick one) ---

# Anthropic — Claude Sonnet 4.6 (default & recommended; prompt-cached system prompts).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq (free tier; alternative)
# Sign up at https://console.groq.com to get a key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (paid; alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Prompt caching for Claude — saves ~90% input cost when the same system
# prompt is reused. Auto-skips prompts under Anthropic's 1024-token floor.
ENABLE_PROMPT_CACHING=true

# Reasoning mode for the chat workflow:
#   graph  — (DEFAULT) classifier-then-branch fan-out → composer. Predictable,
#            preserves all structured-state fields (appointment, record_change,
#            history_summary, medical_info, sources) directly through the node
#            outputs the eval, audit log, Streamlit panel, and Next.js artifact
#            rows depend on.
#   react  — EXPERIMENTAL: single agent_loop node uses Claude tool-use to pick
#            + compose tools dynamically. Handles novel queries like "what's
#            on Dr. Nair's calendar?", "cancel that appointment", or "who
#            accessed my records" without adding classifier intents. PHI-scope
#            guardrails live in the dispatcher (patient_chat role cannot
#            enumerate the patient table, cannot read/cancel other patients'
#            records, cannot update arbitrary existing records). The
#            accumulator preserves the structured-state contract — same UI
#            artifact rows render under either mode. Opt in with
#            AGENT_MODE=react when ANTHROPIC_API_KEY is set.
AGENT_MODE=graph

# --- Search provider (optional; DuckDuckGo is the default fallback) ---

# Tavily — best quality medical search; sign up at https://tavily.com
TAVILY_API_KEY=

# --- Operational toggles ---

# Set to "false" to disable cross-session conversation persistence
ENABLE_PERSISTENCE=true

# Set to "false" to force sequential routing (default: parallel multi-intent)
ENABLE_PARALLEL_FANOUT=true

# Local artifact paths (relative to project root)
SQLITE_CHECKPOINT_PATH=data/checkpoints.sqlite
EHR_DB_PATH=data/ehr.sqlite
APPOINTMENTS_DB_PATH=data/appointments.sqlite
FAISS_INDEX_PATH=data/faiss.index
FAISS_CHUNKS_PATH=data/faiss_chunks.json

# Path to records.xlsx (the instructor-provided dataset)
RECORDS_XLSX_PATH=../Datasets_New/Agentic Healthcare Assistant for Medical Task Automation/records.xlsx
PATIENT_PDF_DIR=../Datasets_New/Agentic Healthcare Assistant for Medical Task Automation

# --- EHR backend ---
# sqlite        : load records.xlsx into a local SQLite DB (default, course demo)
# fhir          : talk to a live FHIR R4 server (set FHIR_BASE_URL)
# fhir_fixture  : read FHIR-shaped JSON from data/fhir_fixtures/ (offline FHIR)
EHR_BACKEND=sqlite
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_FIXTURE_DIR=data/fhir_fixtures
FHIR_TIMEOUT_SECONDS=10

# --- Audit log (PHI access tracking) ---
AUDIT_DB_PATH=data/audit.sqlite

# --- Observability ---
# Per-invocation JSONL trace log (always on). Read by the 📊 Traces page.
TRACE_LOG_PATH=logs/runs.jsonl
#
# LangSmith (optional but recommended) — auto-traces every LLM call,
# every LangGraph node, and renders a flame graph. Free tier covers
# personal use. Set both vars to opt in.
# LANGCHAIN_API_KEY=ls_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=agentic-healthcare-assistant
