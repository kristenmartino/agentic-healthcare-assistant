# Public-only env vars for the Next.js frontend. NEXT_PUBLIC_* values get
# baked into the client bundle at build time — never put a secret here.
#
# Local development (FastAPI running on port 8000):
NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# Vercel production (FastAPI on Fly.io):
# NEXT_PUBLIC_API_BASE=https://agentic-healthcare-api.fly.dev
#
# Frontend is served at https://agentic-healthcare.kristenmartino.ai
# (add the custom domain in Vercel → Settings → Domains).
